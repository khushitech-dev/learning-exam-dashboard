# Copy this file to .env and fill in your values.
# Get these from Supabase Dashboard -> Project Settings -> API & Database.

# PostgreSQL connection string (Direct connection or Transaction pooler).
# Format: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@host:6543/postgres

# Supabase URL + Service Role key (used ONLY server-side for Storage).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional override for the AI provider (highest priority, works like OPENAI_API_KEY env in PHP).
OPENAI_API_KEY=
OPENAI_API_BASE=

# Security secret for CSRF token signing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXAM_CSRF_SECRET=change-me-to-a-long-random-string

# Port the backend listens on.
PORT=3000

# Directory containing the static frontend (exam/). Used only when serving the UI from this server.
STATIC_DIR=../exam